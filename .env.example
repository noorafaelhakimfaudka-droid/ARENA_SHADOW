# Shadow Arena Environment Configuration
# API key untuk Google Gemini SDK (google-genai). Kosongkan untuk mode OFFLINE.
GEMINI_API_KEY=

# Model Gemini yang digunakan (jangan di-hardcode)
GEMINI_MODEL=gemini-3.1-flash-lite

# Konfigurasi Server
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Batas Resource & Data
MAX_FILE_SIZE_MB=20
MAX_ROWS_SAMPLING=50000
STEP_TIMEOUT_SECONDS=120
